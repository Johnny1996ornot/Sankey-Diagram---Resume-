        function executeBatchLayout(action) {
            if (selectedNodeIds.size < 2) { alert("Please select at least 2 boxes to use layout tools."); return; }
            pushToHistory();
            const selectedArray = Array.from(selectedNodeIds);
            const anchorId = selectedArray[0]; 
            const anchorData = appState.nodes.find(n => n.id === anchorId);
            if (!anchorData) return;
            let modified = false;

            if (action === 'align-left') {
                selectedArray.forEach(id => { if (id !== anchorId) { let n = appState.nodes.find(node => node.id === id); n.x = anchorData.x; document.getElementById(id).style.left = n.x + 'px'; } }); modified = true;
            } else if (action === 'align-center') {
                let anchorCenter = anchorData.x + (anchorData.w / 2);
                selectedArray.forEach(id => { if (id !== anchorId) { let n = appState.nodes.find(node => node.id === id); n.x = anchorCenter - (n.w / 2); document.getElementById(id).style.left = n.x + 'px'; } }); modified = true;
            } else if (action === 'align-top') {
                selectedArray.forEach(id => { if (id !== anchorId) { let n = appState.nodes.find(node => node.id === id); n.y = anchorData.y; document.getElementById(id).style.top = n.y + 'px'; } }); modified = true;
            } else if (action === 'match-width') {
                selectedArray.forEach(id => { if (id !== anchorId) { let n = appState.nodes.find(node => node.id === id); n.w = anchorData.w; document.getElementById(id).style.width = n.w + 'px'; } }); modified = true;
            } else if (action === 'match-height') {
                selectedArray.forEach(id => { if (id !== anchorId) { let n = appState.nodes.find(node => node.id === id); n.h = anchorData.h; document.getElementById(id).style.height = n.h + 'px'; } }); modified = true;
            } else if (action === 'distribute-h') {
                if(selectedArray.length > 2) {
                    let sortedNodes = selectedArray.map(id => appState.nodes.find(n => n.id === id)).sort((a,b) => a.x - b.x);
                    let first = sortedNodes[0], last = sortedNodes[sortedNodes.length - 1];
                    let totalSpace = (last.x) - (first.x + first.w);
                    let totalInnerWidths = 0;
                    for(let i=1; i<sortedNodes.length-1; i++) totalInnerWidths += sortedNodes[i].w;
                    let gap = (totalSpace - totalInnerWidths) / (sortedNodes.length - 1);
                    if(gap < 0) gap = 20; 
                    let currX = first.x + first.w + gap;
                    for (let i=1; i<sortedNodes.length-1; i++) { sortedNodes[i].x = currX; document.getElementById(sortedNodes[i].id).style.left = currX + 'px'; currX += sortedNodes[i].w + gap; }
                    modified = true;
                }
            } else if (action === 'distribute-v') {
                if(selectedArray.length > 2) {
                    let sortedNodes = selectedArray.map(id => appState.nodes.find(n => n.id === id)).sort((a,b) => a.y - b.y);
                    let first = sortedNodes[0], last = sortedNodes[sortedNodes.length - 1];
                    let totalSpace = (last.y) - (first.y + first.h);
                    let totalInnerHeights = 0;
                    for(let i=1; i<sortedNodes.length-1; i++) totalInnerHeights += sortedNodes[i].h;
                    let gap = (totalSpace - totalInnerHeights) / (sortedNodes.length - 1);
                    if(gap < 0) gap = 20; 
                    let currY = first.y + first.h + gap;
                    for (let i=1; i<sortedNodes.length-1; i++) { sortedNodes[i].y = currY; document.getElementById(sortedNodes[i].id).style.top = currY + 'px'; currY += sortedNodes[i].h + gap; }
                    modified = true;
                }
            }
            if (modified) { saveStateToBrowser(); recalculateSankeyCurves(); }
        }

