            const exportPaperBox = document.getElementById('paper-guide-box');
            const wasPaperVisible = exportPaperBox.style.display;
            exportPaperBox.style.display = 'none';
            
            let minX = Infinity, minY = Infinity, maxX = 0, maxY = 0;
            appState.nodes.forEach(n => {
                let el = document.getElementById(n.id);
                let liveW = el ? el.offsetWidth : n.w; let liveH = el ? el.offsetHeight : n.h;
                if(n.x < minX) minX = n.x; if(n.y < minY) minY = n.y;
                if(n.x + liveW > maxX) maxX = n.x + liveW; if(n.y + liveH > maxY) maxY = n.y + liveH;
            });
            appState.connections.forEach(c => {
                let s = appState.nodes.find(n => n.id === c.source); let t = appState.nodes.find(n => n.id === c.target);
                if(s && t) {
                    let elS = document.getElementById(s.id); let wS = elS ? elS.offsetWidth : s.w;
                    let x0 = s.x + wS; let x1 = t.x;
                    let curveForce = c.curvature !== undefined ? c.curvature : 0.45; let dx = Math.abs(x1 - x0) * curveForce;
                    let cMinX = Math.min(x0, x1, x0+dx, x1-dx); let cMaxX = Math.max(x0, x1, x0+dx, x1-dx);
                    if (cMinX < minX) minX = cMinX; if (cMaxX > maxX) maxX = cMaxX;
                }
            });

            if(minX === Infinity) { minX = 0; minY = 0; maxX = 800; maxY = 600; }
            
            const pad = 100;
            minX = Math.max(0, minX - pad); minY = Math.max(0, minY - pad); 
            maxX += pad; maxY += pad;
            let cropW = maxX - minX; let cropH = maxY - minY;

            let exportDiv = document.createElement('div');
            exportDiv.style.position = 'fixed'; exportDiv.style.top = '0px'; exportDiv.style.left = '0px';
            exportDiv.style.width = cropW + 'px'; exportDiv.style.height = cropH + 'px';
