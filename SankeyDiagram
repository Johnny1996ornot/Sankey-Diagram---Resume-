    <script>
        let operationalMode = 'move';
        let connectionSourceNode = null;
        let activeEditorTarget = null;
        let zoomLevel = 1.0;
        
        let selectedNodeIds = new Set();
        let selectedEdgeIds = new Set();
        
        let appState = { nodes: [], connections: [] };
        let undoStack = []; 
        
        let isMarqueeDragging = false;
        let mStartX = 0, mStartY = 0;

        const container = document.getElementById('canvas-container');
        const board = document.getElementById('canvas-board');
        const svg = document.getElementById('sankey-svg');
        const marqueeBox = document.getElementById('marquee-box');

        // ==========================================
        // TRUE DRAGGABLE/RESIZABLE PAPER VIEWFINDER (PROPORTIONAL)
        // ==========================================
        const paperBox = document.getElementById('paper-guide-box');
        const paperBoxHeader = document.getElementById('paper-guide-header');
        const paperBoxResizer = document.getElementById('paper-guide-resizer');
        const paperSizeDropdown = document.getElementById('paper-size');
        const paperScaleSlider = document.getElementById('paper-scale');
        const paperTitleDisplay = document.getElementById('paper-guide-title');
        
        let isDraggingPaperBox = false;
        let isResizingPaperBox = false;
        let pbStartX, pbStartY, pbStartW, pbStartH, pbBaseW;

        // 1. Dragging the Header Bar
        paperBoxHeader.addEventListener('mousedown', (e) => {
            if(operationalMode !== 'move') return;
            e.stopPropagation(); // Prevent canvas marquee
            isDraggingPaperBox = true;
            const boardRect = board.getBoundingClientRect();
            pbStartX = ((e.clientX - boardRect.left) / zoomLevel) - paperBox.offsetLeft;
            pbStartY = ((e.clientY - boardRect.top) / zoomLevel) - paperBox.offsetTop;
        });

        // 2. Proportional Scaling via Corner Resizer
        paperBoxResizer.addEventListener('mousedown', (e) => {
            if(operationalMode !== 'move') return;
            e.stopPropagation(); // Prevent canvas marquee
            isResizingPaperBox = true;
            pbStartX = e.clientX;
            pbStartW = paperBox.offsetWidth;
            
            // Calculate what the true 1.0x width of the current paper format is
            let size = paperSizeDropdown.value;
            let orient = document.getElementById('paper-orientation').value;
            let baseW = (size === 'letter') ? 850 : (size === 'a4' ? 827 : 850);
            let baseH = (size === 'letter') ? 1100 : (size === 'a4' ? 1169 : 1400);
            if (orient === 'landscape') { baseW = baseH; }
            pbBaseW = baseW;
        });

        // ==========================================
        // FLOATING UI PANEL DRAG LOGIC
        // ==========================================
        const paperPanel = document.getElementById('paper-trace-panel');
        const paperPanelHeader = document.getElementById('paper-trace-panel-header');
        let isDraggingPanel = false, pStartX, pStartY;

        paperPanel.addEventListener('mousedown', (e) => e.stopPropagation()); 
        
        paperPanelHeader.addEventListener('mousedown', (e) => {
            isDraggingPanel = true;
            pStartX = e.clientX - paperPanel.offsetLeft;
            pStartY = e.clientY - paperPanel.offsetTop;
        });

        // Global Mouse Move & Up logic for Paper Systems
        document.addEventListener('mousemove', (e) => {
            if (isDraggingPanel) {
                paperPanel.style.left = (e.clientX - pStartX) + 'px';
                paperPanel.style.top = (e.clientY - pStartY) + 'px';
            }
            if (isDraggingPaperBox) {
                const boardRect = board.getBoundingClientRect();
                let currentX = (e.clientX - boardRect.left) / zoomLevel;
                let currentY = (e.clientY - boardRect.top) / zoomLevel;
                paperBox.style.left = (currentX - pbStartX) + 'px';
                paperBox.style.top = (currentY - pbStartY) + 'px';
            }
            if (isResizingPaperBox) {
                // Determine new desired width based on mouse movement
                let dx = (e.clientX - pbStartX) / zoomLevel;
                let newW = Math.max(100, pbStartW + dx);
                
                // Calculate the true scale multiplier based on the strict paper format
                let newScale = newW / pbBaseW;
                
                // Clamp the scale to sane limits
                if (newScale < 0.2) newScale = 0.2;
                if (newScale > 10.0) newScale = 10.0;
                
                // Drive the UI slider programmatically, acting like a physical scrubber
                paperScaleSlider.value = newScale;
                document.getElementById('scale-val').innerText = newScale.toFixed(1) + 'x';
                
                // Run the central update function which correctly enforces the ratio for both width and height
                updatePaperGuide();
            }
        });
        document.addEventListener('mouseup', () => { 
            isDraggingPanel = false; 
            isDraggingPaperBox = false;
            isResizingPaperBox = false;
        });

        function togglePaperPanel() {
            if (paperPanel.style.display === 'none') {
                paperPanel.style.display = 'flex';
                setTimeout(() => { paperPanel.style.opacity = '1'; }, 10);
            } else {
                paperPanel.style.opacity = '0';
                setTimeout(() => { paperPanel.style.display = 'none'; }, 200);
            }
        }

        function updatePaperGuide() {
            const isEnabled = document.getElementById('toggle-paper').checked;
            if (!isEnabled) { paperBox.style.display = 'none'; return; }
            
            const size = paperSizeDropdown.value;
            const orientation = document.getElementById('paper-orientation').value;
            const scale = parseFloat(paperScaleSlider.value);
            
            let w, h, labelText;
            
            if (size === 'letter') { w = 850; h = 1100; labelText = "Short / Letter"; }
            else if (size === 'a4') { w = 827; h = 1169; labelText = "A4"; }
            else if (size === 'legal') { w = 850; h = 1400; labelText = "Legal"; }
            
            if (orientation === 'landscape') {
                let temp = w; w = h; h = temp;
                labelText += " - Landscape";
            } else {
                labelText += " - Portrait";
            }
            
            // Proportional Locking
            w = w * scale;
            h = h * scale;
            labelText += ` @ ${scale.toFixed(1)}x Scale`;
            
            paperBox.style.width = w + 'px'; 
            paperBox.style.height = h + 'px';
            
            paperTitleDisplay.innerText = labelText;
            paperBox.style.display = 'block';
        }

        function pushToHistory() {
            undoStack.push(JSON.stringify(appState));
            if (undoStack.length > 50) undoStack.shift(); 
        }

        function triggerUndo() {
            if (undoStack.length > 0) {
                let previousState = undoStack.pop();
                appState = JSON.parse(previousState);
                rebuildCanvasFromState();
                saveStateToBrowser();
                document.getElementById('workspace-status').innerText = "Action undone.";
            }
        }

        document.addEventListener('keydown', (e) => {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) return;
            const cmdOrCtrl = e.ctrlKey || e.metaKey;

            if (cmdOrCtrl && e.key.toLowerCase() === 'a') {
                e.preventDefault();
                if (operationalMode !== 'move') return;
                clearAllSelections();
                let first = true;
                appState.nodes.forEach(n => {
                    selectedNodeIds.add(n.id);
                    let el = document.getElementById(n.id);
                    if(el) { el.classList.add('selected'); if (first) { el.classList.add('selected-anchor'); first = false; } }
                });
                appState.connections.forEach(c => selectedEdgeIds.add(c.id));
                refreshEdgeSelectionVisuals();
            } else if (cmdOrCtrl && e.key.toLowerCase() === 'z') {
                e.preventDefault(); triggerUndo();
            } else if (cmdOrCtrl && e.key.toLowerCase() === 's') {
                e.preventDefault(); downloadNativeHTML();
            } else if (e.key === 'Delete' || e.key === 'Backspace') {
                e.preventDefault(); executeDeletion();
            }
        });

        document.addEventListener('copy', (e) => {
            if (operationalMode !== 'move' || document.activeElement.isContentEditable) return;
            let pack = [];
            selectedNodeIds.forEach(id => {
                const nodeData = appState.nodes.find(n => n.id === id);
                if (nodeData) pack.push(nodeData);
            });
            if (pack.length > 0) {
                e.clipboardData.setData('text/plain', JSON.stringify({ type: 'SANKEY_CLIPBOARD', data: pack }));
                e.preventDefault();
                document.getElementById('workspace-status').innerText = `Copied ${pack.length} item(s).`;
                setTimeout(() => document.getElementById('workspace-status').innerText = "", 2000);
            }
        });

        document.addEventListener('paste', (e) => {
            if (operationalMode !== 'move' || document.activeElement.isContentEditable) return;
            try {
                let textData = e.clipboardData.getData('text/plain');
                let payload = JSON.parse(textData);
                if (payload && payload.type === 'SANKEY_CLIPBOARD') {
                    pushToHistory(); 
                    clearAllSelections();
                    let first = true;
                    
                    let allZs = appState.nodes.map(n => n.zIndex || 10);
                    let maxZ = allZs.length > 0 ? Math.max(...allZs) : 10;
                    
                    payload.data.forEach(nodeData => {
                        let newNode = JSON.parse(JSON.stringify(nodeData));
                        newNode.id = 'node_' + Date.now() + Math.floor(Math.random() * 1000);
                        newNode.x += 60; newNode.y += 60;
                        newNode.zIndex = ++maxZ; 
                        
                        appState.nodes.push(newNode);
                        buildNodeDOM(newNode);
                        selectedNodeIds.add(newNode.id);
                        let el = document.getElementById(newNode.id);
                        el.classList.add('selected');
                        if (first) { el.classList.add('selected-anchor'); first = false; }
                    });
                    saveStateToBrowser();
                }
            } catch (err) { }
        });

        container.addEventListener('wheel', (e) => {
            // Prevent wheel zooming if dragging paper elements to avoid glitches
            if (isDraggingPaperBox || isResizingPaperBox) return; 
            if (e.ctrlKey || e.metaKey) {
                e.preventDefault(); setZoom(e.deltaY * -0.005);
            }
        }, { passive: false });

        function setZoom(dz) {
            zoomLevel += dz;
            if(zoomLevel < 0.05) zoomLevel = 0.05; 
            if(zoomLevel > 3.0) zoomLevel = 3.0;
            board.style.transform = `scale(${zoomLevel})`;
        }
        function resetZoom() { zoomLevel = 1.0; board.style.transform = `scale(${zoomLevel})`; }

        function drawRulers() {
            let rx = document.getElementById('ruler-x-svg');
            let ry = document.getElementById('ruler-y-svg');
            if(!rx || !ry) return;
            let strX = '', strY = '';
            const pxPerCm = 37.8; 
            
            for(let cm=0; cm<=310; cm++) {
                let px = cm * pxPerCm;
                let isMajor = (cm % 5 === 0);
                let y1 = isMajor ? 12 : 22;
                strX += `<line x1="${px}" y1="${y1}" x2="${px}" y2="30" stroke="#a4b0be" stroke-width="1"/>`;
                if (cm > 0) strX += `<text x="${px+2}" y="12" font-size="${isMajor ? 11 : 9}" font-weight="${isMajor ? 'bold' : 'normal'}" fill="#a4b0be" font-family="sans-serif">${cm}</text>`;
                let x1 = isMajor ? 12 : 22;
                strY += `<line x1="${x1}" y1="${px}" x2="30" y2="${px}" stroke="#a4b0be" stroke-width="1"/>`;
                if (cm > 0) strY += `<text x="2" y="${px-3}" font-size="${isMajor ? 10 : 8}" font-weight="${isMajor ? 'bold' : 'normal'}" fill="#a4b0be" font-family="sans-serif">${cm}</text>`;
            }
            rx.innerHTML = strX; ry.innerHTML = strY;
        }

        function bootstrapStudio() {
            if (window.INJECTED_APP_STATE) {
                appState = window.INJECTED_APP_STATE;
                localStorage.setItem('true_sankey_cv', JSON.stringify(appState));
            } else {
                const savedData = localStorage.getItem('true_sankey_cv');
                if (savedData) { appState = JSON.parse(savedData); } 
                else { appState = { nodes: [], connections: [] }; spawnNewNode('structural'); }
            }
            drawRulers(); 
            rebuildCanvasFromState(); 
            updatePaperGuide(); 
            container.focus();
        }

        function rebuildCanvasFromState() {
            board.querySelectorAll('.sankey-node, .floating-text-node, .group-node').forEach(e => e.remove());
            appState.nodes.forEach(buildNodeDOM);
            recalculateSankeyCurves();
            refreshEdgeSelectionVisuals();
            
            selectedNodeIds.forEach(id => {
                let el = document.getElementById(id);
                if (el) el.classList.add('selected');
            });
            if (selectedNodeIds.size > 0) {
                let anchorId = Array.from(selectedNodeIds)[0];
                let aEl = document.getElementById(anchorId);
                if (aEl) aEl.classList.add('selected-anchor');
            }
        }

        function saveStateToBrowser() {
            appState.nodes.forEach(nData => {
                const domEl = document.getElementById(nData.id);
                if (domEl) { nData.x = domEl.offsetLeft; nData.y = domEl.offsetTop; nData.w = domEl.offsetWidth; nData.h = domEl.offsetHeight; }
            });
            localStorage.setItem('true_sankey_cv', JSON.stringify(appState));
        }

        function clearLocalStorage() {
            if(confirm("Wipe canvas entirely?")) { localStorage.removeItem('true_sankey_cv'); location.reload(); }
        }

        function hexToRgbA(hex, alpha){
            let c;
            if(/^#([A-Fa-f0-9]{3}){1,2}$/.test(hex)){
                c= hex.substring(1).split('');
                if(c.length== 3){ c= [c[0], c[0], c[1], c[1], c[2], c[2]]; }
                c= '0x'+c.join('');
                return 'rgba('+[(c>>16)&255, (c>>8)&255, c&255].join(',')+','+alpha+')';
            }
            return hex; 
        }

        function buildNodeDOM(data) {
            const el = document.createElement('div');
            el.id = data.id; 
            if (data.type === 'structural') el.className = 'sankey-node';
            else if (data.type === 'group') el.className = 'group-node';
            else el.className = 'floating-text-node';
            
            el.style.width = data.w + 'px'; el.style.height = data.h + 'px'; el.style.left = data.x + 'px'; el.style.top = data.y + 'px';
            el.style.color = data.textColor || (data.type === 'floating' ? '#2f3542' : '#ffffff');
            
            let baseZ = data.type === 'group' ? 10 : (data.type === 'floating' ? 30 : 20);
            if (data.zIndex === undefined) data.zIndex = baseZ; 
            el.style.zIndex = data.zIndex;
            let fs = data.fontSize || (data.type === 'group' ? 16 : 12);

            if(data.type !== 'floating') {
                el.style.backgroundColor = hexToRgbA(data.color, data.opacity !== undefined ? data.opacity : 1.0);
                if (data.type === 'group' || data.type === 'structural') {
                    el.style.borderColor = data.borderColor || data.color;
                    el.style.borderWidth = (data.borderWidth !== undefined ? data.borderWidth : (data.type === 'group' ? 2 : 0)) + 'px';
                    if(data.type === 'structural') el.style.borderStyle = 'solid';
                }
            } else {
                el.style.fontSize = fs + 'px';
            }
            
            el.innerHTML = `<div class="rich-content" style="${data.type !== 'floating' ? `font-size: ${fs}px;` : ''}">${data.content}</div><div class="custom-resizer" title="Drag to Resize"></div>`;
            
            attachDraggingController(el);
            
            el.addEventListener('dblclick', (e) => { 
                e.stopPropagation(); 
                if(operationalMode === 'move') { 
                    if(e.ctrlKey || e.metaKey || selectedNodeIds.size > 1) {
                        if(!selectedNodeIds.has(data.id)) { handleSelectionLogic(el, false); }
                        openBatchNodeEditor();
                    } else {
                        activeEditorTarget = data; openNodeEditor(data); 
                    }
                } 
            });
            board.appendChild(el);
        }

        function handleSelectionLogic(el, isCtrlDown) {
            if (isCtrlDown) {
                if (selectedNodeIds.has(el.id)) {
                    selectedNodeIds.delete(el.id); el.classList.remove('selected', 'selected-anchor');
                    if (selectedNodeIds.size > 0) {
                        let newAnchorId = Array.from(selectedNodeIds)[0];
                        document.getElementById(newAnchorId).classList.add('selected-anchor');
                    }
                } else {
                    let isFirst = selectedNodeIds.size === 0;
                    selectedNodeIds.add(el.id); el.classList.add('selected');
                    if (isFirst) el.classList.add('selected-anchor');
                }
            } else {
                if (!selectedNodeIds.has(el.id)) {
                    clearAllSelections();
                    selectedNodeIds.add(el.id);
                    el.classList.add('selected', 'selected-anchor');
                }
            }
        }

        function attachDraggingController(el) {
            let dragging = false, resizing = false, startX, startY, moved = false;
            let initialPositions = new Map();
            let startW, startH;

            let resizer = el.querySelector('.custom-resizer');
            if (resizer) {
                resizer.addEventListener('mousedown', (e) => {
                    if(operationalMode !== 'move') return;
                    e.stopPropagation(); 
                    resizing = true;
                    startX = e.clientX;
                    startY = e.clientY;
                    startW = el.offsetWidth;
                    startH = el.offsetHeight;
                });
            }

            el.addEventListener('mousedown', (e) => { 
                if(operationalMode !== 'move') {
                    if(operationalMode === 'connect' && (el.classList.contains('sankey-node') || el.classList.contains('group-node'))) {
                        e.stopPropagation(); executeFlowWiring(el, el.id);
                    }
                    return;
                }
                e.stopPropagation(); handleSelectionLogic(el, (e.ctrlKey || e.metaKey));
                dragging = true; moved = false;
                const boardRect = board.getBoundingClientRect();
                startX = (e.clientX - boardRect.left) / zoomLevel; 
                startY = (e.clientY - boardRect.top) / zoomLevel;
                initialPositions.clear();
                selectedNodeIds.forEach(id => {
                    let nodeEl = document.getElementById(id);
                    if(nodeEl) initialPositions.set(id, { x: nodeEl.offsetLeft, y: nodeEl.offsetTop });
                });
            });

            document.addEventListener('mousemove', (e) => { 
                if (resizing) {
                    let dx = (e.clientX - startX) / zoomLevel;
                    let dy = (e.clientY - startY) / zoomLevel;
                    el.style.width = Math.max(40, startW + dx) + 'px';
                    el.style.height = Math.max(30, startH + dy) + 'px';
                    recalculateSankeyCurves();
                    return;
                }
                if(!dragging) return; 
                moved = true;
                const boardRect = board.getBoundingClientRect();
                let dx = ((e.clientX - boardRect.left) / zoomLevel) - startX;
                let dy = ((e.clientY - boardRect.top) / zoomLevel) - startY;
                selectedNodeIds.forEach(id => {
                    let nodeEl = document.getElementById(id); let initPos = initialPositions.get(id);
                    if(nodeEl && initPos) {
                        nodeEl.style.left = Math.max(0, initPos.x + dx) + 'px';
                        nodeEl.style.top = Math.max(0, initPos.y + dy) + 'px';
                    }
                });
                recalculateSankeyCurves(); 
            });
            document.addEventListener('mouseup', () => { 
                if (resizing) { resizing = false; pushToHistory(); saveStateToBrowser(); }
                if (dragging) { dragging = false; if(moved) { pushToHistory(); saveStateToBrowser(); } } 
            });
        }
        
        // Prevent marquee from firing if clicking on the paper box header or resizer
        board.addEventListener('mousedown', (e) => {
            if (e.target.id === 'paper-guide-header' || e.target.id === 'paper-guide-resizer' || e.target.id === 'paper-guide-title') return;
            
            if (operationalMode === 'move' && (e.target === board || e.target === svg || e.target.id === 'ruler-x-svg' || e.target.id === 'ruler-y-svg' || e.target.id === 'paper-guide-box')) {
                clearAllSelections(); isMarqueeDragging = true;
                const boardRect = board.getBoundingClientRect();
                mStartX = (e.clientX - boardRect.left) / zoomLevel; mStartY = (e.clientY - boardRect.top) / zoomLevel;
                marqueeBox.style.display = 'block'; marqueeBox.style.left = mStartX + 'px'; marqueeBox.style.top = mStartY + 'px'; marqueeBox.style.width = '0px'; marqueeBox.style.height = '0px';
            }
        });

        document.addEventListener('mousemove', (e) => {
            if (isMarqueeDragging) {
                const boardRect = board.getBoundingClientRect();
                let currentX = (e.clientX - boardRect.left) / zoomLevel; let currentY = (e.clientY - boardRect.top) / zoomLevel;
                let x = Math.min(mStartX, currentX); let y = Math.min(mStartY, currentY);
                let w = Math.abs(currentX - mStartX); let h = Math.abs(currentY - mStartY);
                marqueeBox.style.left = x + 'px'; marqueeBox.style.top = y + 'px'; marqueeBox.style.width = w + 'px'; marqueeBox.style.height = h + 'px';
            }
        });

        document.addEventListener('mouseup', (e) => {
            if (isMarqueeDragging) {
                isMarqueeDragging = false; marqueeBox.style.display = 'none';
                let mx = parseFloat(marqueeBox.style.left); let my = parseFloat(marqueeBox.style.top);
                let mw = parseFloat(marqueeBox.style.width); let mh = parseFloat(marqueeBox.style.height);
                if (mw > 10 && mh > 10) {
                    appState.nodes.forEach(n => {
                        if (n.x < mx + mw && n.x + n.w > mx && n.y < my + mh && n.y + n.h > my) {
                            selectedNodeIds.add(n.id); let el = document.getElementById(n.id); if(el) el.classList.add('selected');
                        }
                    });
                    appState.connections.forEach(c => {
                        let s = appState.nodes.find(n => n.id === c.source); let t = appState.nodes.find(n => n.id === c.target);
                        if (s && t) {
                            let px0 = s.x + s.w; let py0 = s.y + (s.h/2); let px1 = t.x; let py1 = t.y + (t.h/2);
                            if ((px0 >= mx && px0 <= mx+mw && py0 >= my && py0 <= my+mh) || (px1 >= mx && px1 <= mx+mw && py1 >= my && py1 <= my+mh)) {
                                selectedEdgeIds.add(c.id);
                            }
                        }
                    });
                    let first = true;
                    selectedNodeIds.forEach(id => { let el = document.getElementById(id); if(first && el) { el.classList.add('selected-anchor'); first = false; } });
                    refreshEdgeSelectionVisuals();
                }
            }
        });

        function refreshEdgeSelectionVisuals() {
            appState.connections.forEach(c => {
                let p = document.getElementById('edge_path_' + c.id);
                if (p) {
                    const isSelected = selectedEdgeIds.has(c.id);
                    p.setAttribute('fill', isSelected ? '#ff4757' : (c.color || '#ced6e0'));
                    p.setAttribute('opacity', isSelected ? '0.9' : (c.opacity !== undefined ? c.opacity : 0.6));
                }
            });
        }

        function recalculateSankeyCurves() {
            svg.innerHTML = '';
            let flowStats = {};
            appState.nodes.forEach(n => { flowStats[n.id] = { totalOut: 0, totalIn: 0, currentOut: 0, currentIn: 0 }; });
            
            appState.connections.forEach(conn => {
                if(flowStats[conn.source]) flowStats[conn.source].totalOut += (conn.thickSrc || 10);
                if(flowStats[conn.target]) flowStats[conn.target].totalIn += (conn.thickTgt || 10);
            });

            appState.connections.forEach(conn => {
                const src = document.getElementById(conn.source); const tgt = document.getElementById(conn.target);
                if(!src || !tgt) return;
                
                const srcNodeData = appState.nodes.find(n => n.id === conn.source);
                const tgtNodeData = appState.nodes.find(n => n.id === conn.target);
                
                let scaleOut = flowStats[conn.source].totalOut > src.offsetHeight ? src.offsetHeight / flowStats[conn.source].totalOut : 1;
                let scaleIn = flowStats[conn.target].totalIn > tgt.offsetHeight ? tgt.offsetHeight / flowStats[conn.target].totalIn : 1;
                
                let tSrc = (conn.thickSrc || 10) * scaleOut; let tTgt = (conn.thickTgt || 10) * scaleIn;
                let srcCenterY = src.offsetTop + (src.offsetHeight / 2); let tgtCenterY = tgt.offsetTop + (tgt.offsetHeight / 2);
                
                if (srcNodeData && srcNodeData.type === 'group') { srcCenterY = src.offsetTop + 40 + ((flowStats[conn.source].totalOut * scaleOut) / 2); }
                if (tgtNodeData && tgtNodeData.type === 'group') { tgtCenterY = tgt.offsetTop + 40 + ((flowStats[conn.target].totalIn * scaleIn) / 2); }
                
                const y0_center = srcCenterY - ((flowStats[conn.source].totalOut * scaleOut) / 2) + flowStats[conn.source].currentOut + (tSrc / 2);
                const y1_center = tgtCenterY - ((flowStats[conn.target].totalIn * scaleIn) / 2) + flowStats[conn.target].currentIn + (tTgt / 2);
                
                flowStats[conn.source].currentOut += tSrc; flowStats[conn.target].currentIn += tTgt;
                
                const x0 = src.offsetLeft + src.offsetWidth; const x1 = tgt.offsetLeft;
                const y0_top = y0_center - (tSrc / 2); const y0_bot = y0_center + (tSrc / 2);
                const y1_top = y1_center - (tTgt / 2); const y1_bot = y1_center + (tTgt / 2);
                
                const curveForce = conn.curvature !== undefined ? conn.curvature : 0.45;
                const dx = Math.abs(x1 - x0) * curveForce;
                
                const pathData = `M ${x0} ${y0_top} C ${x0 + dx} ${y0_top}, ${x1 - dx} ${y1_top}, ${x1} ${y1_top} L ${x1} ${y1_bot} C ${x1 - dx} ${y1_bot}, ${x0 + dx} ${y0_bot}, ${x0} ${y0_bot} Z`;
                
                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.id = 'edge_path_' + conn.id; path.setAttribute('d', pathData);
                
                const isSelected = selectedEdgeIds.has(conn.id);
                path.setAttribute('fill', isSelected ? '#ff4757' : (conn.color || '#ced6e0'));
                path.setAttribute('opacity', isSelected ? '0.9' : (conn.opacity !== undefined ? conn.opacity : 0.6));
                
                path.addEventListener('mousedown', (e) => {
                    e.stopPropagation();
                    if(operationalMode === 'disconnect') {
                        pushToHistory(); appState.connections = appState.connections.filter(c => c.id !== conn.id); recalculateSankeyCurves(); saveStateToBrowser();
                    } else if (operationalMode === 'move') {
                        if (e.ctrlKey || e.metaKey) {
                            if (selectedEdgeIds.has(conn.id)) selectedEdgeIds.delete(conn.id); else selectedEdgeIds.add(conn.id);
                        } else {
                            if (!selectedEdgeIds.has(conn.id)) { clearAllSelections(); selectedEdgeIds.add(conn.id); }
                        }
                        refreshEdgeSelectionVisuals();
                    }
                });

                path.addEventListener('dblclick', (e) => {
                    e.stopPropagation();
                    if (operationalMode === 'move') { 
                        if(e.ctrlKey || e.metaKey || selectedEdgeIds.size > 1) {
                            if(!selectedEdgeIds.has(conn.id)) selectedEdgeIds.add(conn.id); openBatchEdgeEditor();
                        } else { activeEditorTarget = conn; openEdgeEditor(conn); }
                    }
                });
                svg.appendChild(path);
            });
        }

        function triggerSmartCut() {
            if (selectedEdgeIds.size > 0) {
                if (selectedNodeIds.size > 0) { if (!confirm("⚠️ WARNING: You have boxes selected. Slice ONLY the lines?")) return; }
                pushToHistory();
                selectedEdgeIds.forEach(id => { appState.connections = appState.connections.filter(c => c.id !== id); });
                selectedEdgeIds.clear(); recalculateSankeyCurves(); saveStateToBrowser();
                document.getElementById('workspace-status').innerText = "Lines severed.";
                setTimeout(() => document.getElementById('workspace-status').innerText = "", 2000);
                switchEngineMode('move'); 
            } else { switchEngineMode('disconnect'); }
        }

        function switchEngineMode(mode) {
            if (operationalMode === mode) mode = 'move';
            operationalMode = mode; connectionSourceNode = null; clearAllSelections();
